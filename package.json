{
  "name": "seleniumbase-rs-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser extensions that record, inspect and export tests for seleniumbase-rs",
  "license": "MIT",
  "scripts": {
    "build": "\"$npm_execpath\" scripts/build.ts",
    "build:e2e": "\"$npm_execpath\" scripts/build.ts --e2e",
    "test": "\"$npm_execpath\" test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/tsconfig.json && \"$npm_execpath\" scripts/lint.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/chrome": "0.3.5",
    "@types/firefox-webext-browser": "143.0.1",
    "happy-dom": "21.0.1",
    "typescript": "7.0.2"
  }
}
