{
  "manifest_version": 3,
  "name": "seleniumbase-rs Companion",
  "short_name": "sbrs Companion",
  "description": "Record clicks and typing, inspect selectors and what a page sees, and export tests for seleniumbase-rs. Everything stays in your browser.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "seleniumbase-rs Companion",
    "default_popup": "ui/panel.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; form-action 'none'"
  },
  "chrome": {
    "minimum_chrome_version": "116",
    "background": {
      "service_worker": "background.js"
    },
    "permissions": ["sidePanel"],
    "side_panel": {
      "default_path": "ui/panel.html"
    }
  },
  "firefox": {
    "background": {
      "scripts": ["background.js"]
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "seleniumbase-rs-companion@seleniumbase-rs",
        "strict_min_version": "128.0",
        "data_collection_permissions": {
          "required": ["none"]
        }
      }
    },
    "sidebar_action": {
      "default_title": "seleniumbase-rs Companion",
      "default_panel": "ui/panel.html",
      "default_icon": "icons/32.png"
    }
  }
}
